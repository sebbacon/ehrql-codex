# ─── grite open ────────────────────────────────────────────────────────────────

cmd_open() {
    if [ $# -lt 1 ]; then
        echo "Usage: grite open <task-name>" >&2
        exit 1
    fi

    local SPRITE_NAME="grite-${1}"
    local url
    url="$(sprite api "/v1/sprites/${SPRITE_NAME}" 2>/dev/null | jq -r '.url // empty')"

    if [[ -z "$url" ]]; then
        echo "Sprite '$SPRITE_NAME' not found." >&2
        exit 1
    fi

    echo "Opening $url"
    _open_url "$url"
}

# ─── grite c ───────────────────────────────────────────────────────────────────

cmd_console() {
    if [ $# -lt 1 ]; then
        echo "Usage: grite c <task-name>" >&2
        exit 1
    fi

    local SPRITE_NAME="grite-${1}"

    local sessions
    sessions="$(sprite api "/v1/sprites/${SPRITE_NAME}/exec" 2>/dev/null)"

    local session_id
    session_id="$(echo "$sessions" | jq -r '[.sessions[] | select(.tty == true)] | sort_by(.created) | last | .id // empty')"

    if [[ -n "$session_id" ]]; then
        echo "Attaching to session $session_id"
        TERM=xterm exec sprite sessions attach "$session_id" -s "$SPRITE_NAME"
    else
        echo "Starting new console"
        TERM=xterm exec sprite c -s "$SPRITE_NAME"
    fi
}

# ─── main ──────────────────────────────────────────────────────────────────────

case "${1:-}" in
    new)   shift; cmd_new "$@" ;;
    join)  shift; cmd_join "$@" ;;
    rm)    shift; cmd_rm "$@" ;;
    ls)    cmd_ls ;;
    open)  shift; cmd_open "$@" ;;
    c)     shift; cmd_console "$@" ;;
    *)
        echo "Usage: grite <new|join|rm|ls|open|c> [args]" >&2
        echo "" >&2
        echo "  grite new  [task-name]      Create a new grite and push the current repo" >&2
        echo "  grite join <task-name>      Add the current repo to an existing grite" >&2
        echo "  grite rm   <task-name>      Destroy a grite and remove all its remotes" >&2
        echo "  grite open <task-name>      Open a grite's URL in the browser" >&2
        echo "  grite c    <task-name>      Attach to or start a console session" >&2
        echo "  grite ls                    List all grites and their status" >&2
        exit 1
        ;;
esac
